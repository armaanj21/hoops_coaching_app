VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# The Claude API key lives ONLY as a Supabase Edge Function secret (ANTHROPIC_API_KEY), never
# here — see supabase/functions/claude-analysis. Set it with:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# Max upload size for drill/game-film videos, in MB. Supabase Free-tier projects hard-cap
# individual uploads at 50MB regardless of what the Dashboard's "Global file size limit" field
# shows or lets you type (confirmed via Supabase's own docs: "For Free projects, the limit can't
# exceed 50 MB") — bumping this above 50 will fail server-side even if the Dashboard appears to
# allow a higher number. Only raise this if the Supabase project is upgraded to the Pro plan
# (500 GB ceiling) or higher.
VITE_MAX_UPLOAD_MB=50
